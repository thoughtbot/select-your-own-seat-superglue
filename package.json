{
  "name": "app",
  "private": true,
  "dependencies": {
    "@reduxjs/toolkit": "^2.6.1",
    "@thoughtbot/superglue": "^1.0.2",
    "breakpoint-sass": "2.7.1",
    "dialog-polyfill": "^0.5.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-inlinesvg": "^4.1.5",
    "react-redux": "^9.2.0",
    "sass": "^1.85.1",
    "svg-pan-zoom": "^3.6.2"
  },
  "version": "0.1.0",
  "scripts": {
    "build": "yarn run build:web && yarn run build:ssr",
    "build:web": "esbuild app/javascript/application.js --bundle --sourcemap --outdir=app/assets/builds --loader:.js=jsx --loader:.svg=dataurl --public-path=/assets",
    "build:ssr": "node ./build-ssr.mjs",
    "build:css": "sass ./app/assets/stylesheets/application.sass.scss:./app/assets/builds/application.css --no-source-map --load-path=node_modules"
  },
  "devDependencies": {
    "@thoughtbot/candy_wrapper": "^0.0.3",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "esbuild": "^0.25.1",
    "esbuild-plugin-polyfill-node": "^0.3.0",
    "esbuild-plugins-node-modules-polyfill": "^1.6.1",
    "source-map-support": "^0.5.19",
    "whatwg-url": "^14.2.0",
    "text-encoding": "^0.7.0"
  }
}
